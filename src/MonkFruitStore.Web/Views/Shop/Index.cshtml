@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Shop";
}
<h1>Shop EdesMonk</h1>
<div class="grid">
    @foreach (var product in Model)
    {
        <article class="product-card">
            <img src="@product.ImagePath" alt="@product.Name" />
            <p class="badge">@product.PackSize</p>
            <h2>@product.Name</h2>
            <p class="muted">@product.ShortDescription</p>
            <p>SKU: @product.Sku | Stock: @product.StockQuantity</p>
            <p class="price">₹@product.SellingPrice.ToString("N0") <span class="muted"><s>₹@product.Mrp.ToString("N0")</s></span></p>
            <div class="actions">
                <a class="btn secondary" asp-action="Details" asp-route-slug="@product.Slug">View</a>
                <form asp-controller="Cart" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductId" value="@product.Id" />
                    <input type="number" name="Quantity" value="1" min="1" max="20" aria-label="Quantity" />
                    <button type="submit">Add to Cart</button>
                </form>
            </div>
        </article>
    }
</div>
