<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EdesMonk Store</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span>EM</span>EdesMonk</a>
        <nav class="site-nav">
            <a asp-area="" asp-controller="Shop" asp-action="Index">Shop</a>
            <a asp-area="" asp-controller="Cart" asp-action="Index">Cart</a>
            <a asp-area="" asp-controller="Orders" asp-action="AccountOrders">Orders</a>
            <a asp-area="" asp-controller="Home" asp-action="Policies">Policies</a>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="link-button" type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login">Login</a>
            }
        </nav>
    </header>

    <main class="page-shell" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>&copy; 2026 EdesMonk</span>
        <a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
        <a asp-area="" asp-controller="Home" asp-action="Policies">Shipping & Refunds</a>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
