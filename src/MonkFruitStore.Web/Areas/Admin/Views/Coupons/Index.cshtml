@model IReadOnlyList<Coupon>
@{
    ViewData["Title"] = "Coupons";
}
<h1>Coupons</h1>
@if (TempData["Error"] is string error)
{
    <div class="alert">@error</div>
}
<form class="panel" asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <div class="form-grid">
        <label><span>Code</span><input name="Code" /></label>
        <label><span>Discount %</span><input name="DiscountPercent" type="number" step="0.01" /></label>
        <label><span>Minimum order</span><input name="MinimumOrderAmount" type="number" step="0.01" /></label>
        <label><span>Active</span><input name="IsActive" type="checkbox" value="true" checked /></label>
    </div>
    <button type="submit">Save Coupon</button>
</form>
<table class="table">
    <thead><tr><th>Code</th><th>Discount</th><th>Minimum</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var coupon in Model)
    {
        <tr><td>@coupon.Code</td><td>@coupon.DiscountPercent%</td><td>₹@coupon.MinimumOrderAmount.ToString("N0")</td><td>@(coupon.IsActive ? "Active" : "Hidden")</td></tr>
    }
    </tbody>
</table>
