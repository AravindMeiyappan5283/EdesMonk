@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Admin Orders";
}
<h1>Orders</h1>
<table class="table">
    <thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Payment</th><th>Total</th><th></th></tr></thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.OrderNumber<br /><span class="muted">@order.CreatedAt.LocalDateTime</span></td>
            <td>@order.ShippingAddress.Name<br /><span class="muted">@order.ShippingAddress.Phone</span></td>
            <td>@order.OrderStatus</td>
            <td>@order.PaymentStatus</td>
            <td>₹@order.TotalAmount.ToString("N0")</td>
            <td><a class="btn secondary" asp-action="Details" asp-route-id="@order.Id">Manage</a></td>
        </tr>
    }
    </tbody>
</table>
