@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Admin Products";
}
<div class="actions">
    <h1>Products</h1>
    <a class="btn" asp-action="Edit">Add Product</a>
</div>
<table class="table">
    <thead><tr><th>Name</th><th>SKU</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Name<br /><span class="muted">@product.Slug</span></td>
            <td>@product.Sku</td>
            <td>₹@product.SellingPrice.ToString("N0")</td>
            <td>@product.StockQuantity</td>
            <td>@(product.IsActive ? "Active" : "Hidden")</td>
            <td><a class="btn secondary" asp-action="Edit" asp-route-id="@product.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
